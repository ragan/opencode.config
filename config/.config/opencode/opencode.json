{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "skill": {
      "web-browsing": "allow"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "timeout": 600000,
      "chunkTimeout": 120000,
      "options": {
        "baseURL": "${OPENCODE_OLLAMA_URI}"
      },
      "models": {
        "qwen3.5:27b": {
          "id": "my_qwen3.5:27b",
          "name": "My Qwen3.5 27B",
          "tools": true,
          "reasoning": true,
        },
        "qwen3-vl": {
          "id": "qwen3-vl:latest",
          "name": "Qwen3 Vision Language",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
