{
  // Rocket copy of the Mac global config (2026-10-26). The tooljet local MCP
  // is back on rocket (node + npm installed 2026-10-26, repo at
  // ~/source/tooljet-mcp). Provider URIs resolve from
  // /etc/opencode/opencode.env (loopback on rocket) the same way as on the Mac.
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "GUIDELINES.md"],
  "references": {
    "vault": {
      "path": "~/.vault/",
      "description": "Documentation vault. Use for questions about the homelab setup, architecture, services, or project notes."
    }
  },
  "skills": {
    // ToolJet app-builder skill ships inside the cloned MCP repo. `~/` is
    // expanded by opencode's skill loader (same as references.vault), so the
    // home dir stays out of this file.
    "paths": [
      "~/source/tooljet-mcp/skills"
    ]
  },
  "mcp": {
    "appsmith": {
      "type": "remote",
      "url": "{env:APPSMITH_MCP_URL}",
      "enabled": false,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:APPSMITH_MCP_KEY}"
      }
    },
    "servers": {
      // Rocket openproject-mcp, fronted by Traefik via zzzzzz.dev.
      "openproject": {
        "type": "remote",
        "url": "{env:OPENPROJECT_MCP_URL}"
      },
      // ToolJet CE on rocket, session-cookie auth (the CE PAT module is a
      // stub — see ~/.vault/tooljet-file-upload.md "Auth model"). Values
      // resolve from the service environment, which systemd loads from
      // /etc/opencode/opencode.env (EnvironmentFile) at service start. On 401:
      // refresh via POST /api/authenticate (kp@hjkl.app), update
      // /etc/opencode/opencode.env (plus ~/.zshenv, tooljet-stacks/.env), then
      // `sudo systemctl restart opencode-server`.
      "tooljet": {
        "type": "local",
        "command": ["node", "/home/kpeek/source/tooljet-mcp/bundle/index.js"],
        "environment": {
          "TOOLJET_URL": "{env:TOOLJET_URL}",
          "TOOLJET_WORKSPACE_ID": "{env:TOOLJET_WORKSPACE_ID}",
          "TOOLJET_SESSION_TOKEN": "{env:TOOLJET_SESSION_TOKEN}"
        }
      }
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    // 252000 - 70000 = 182000 → auto-compact triggers at ~182k tokens.
    // Why so early: the compaction request serializes the whole session and
    // re-expands stored parts (reasoning text, tool-call JSON), inflating it
    // ~1.3x over the live context (observed 2026-10-08: 224.7k live → 290824
    // prompt tokens, rejected by the server's 262144 window). Trigger must satisfy
    // trigger * 1.3 + output <= 262144; output was raised to 16384 on
    // 2026-10-22 because summaries hit the old 8192 cap (✗ truncated/errored).
    // → 182000 * 1.3 + 16384 ≈ 253k ✓
    "reserved": 70000
  },
  "permission": {
    "external_directory": {
      "~/.vault/*": "allow",
      "/tmp/**": "allow",
      // /tmp is a symlink to /private/tmp on macOS; allow both path forms
      "/private/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      // Denied host lives in env (LMM_DENIED_HOST / LMM_DENIED_IP — set with
      // `opencode service set env`, kept out of git) rather than hardcoded.
      // Why deny instead of ask: saved "always allow" approvals are evaluated
      // AFTER config rules (last match wins), so no config `ask` can outrank
      // an approved `ssh *`. The model gets blocked and has to ask in chat.
      // If the vars are unset when the service starts, the patterns degrade to
      // `ssh **` etc. and deny ALL ssh/scp/rsync — conservative but noisy.
      "ssh *{env:LMM_DENIED_HOST}*": "deny",
      "ssh *{env:LMM_DENIED_IP}*": "deny",
      "scp *": "ask",
      "scp *{env:LMM_DENIED_HOST}*": "deny",
      "scp *{env:LMM_DENIED_IP}*": "deny",
      "rsync *": "ask",
      "rsync *{env:LMM_DENIED_HOST}*": "deny",
      "rsync *{env:LMM_DENIED_IP}*": "deny",
      "telnet *": "ask",
      "nc *": "ask",
      "netcat *": "ask",
      "sftp *": "ask",
      "ftp *": "ask",
      "openvpn *": "ask",
      "ike *": "ask"
    },
    "skill": {
      "web-browsing": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "${OPENCODE_LLAMA_URI}",
        "timeout": 1200000,
        "headerTimeout": 1200000
      },
      "models": {
        // llama-server serves whatever model it was launched with — the id here
        // is kept identical to the retired ollama provider id for muscle memory. MTP is
        // server-side (draft-mtp): measured ~120 tok/s vs ~76 via ollama.
        "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k": {
          "id": "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k",
          "name": "Qwen3.8 27B (llama.cpp MTP, 256KiB)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 252000,
            "input": 252000,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (local)",
      "options": {
        // strata.hjkl.app — tailnet-only (grey A → pi4r 100.94.40.28 → pi4r Caddy →
        // rocket:8088; server binds 0.0.0.0 since 2026-11-16, launch preset
        // "UD-IQ4_XS 256K" owns the flags). Key required; loopback
        // http://127.0.0.1:8088/v1 still works on rocket itself.
        "baseURL": "https://strata.hjkl.app/v1",
        "apiKey": "{env:STRATA_API_KEY}",
        "timeout": 1200000,
        "headerTimeout": 1200000
      },
      "models": {
        // limits per `strata connect opencode`: input < context so OpenCode compacts.
        // DFlash2 serves one request at a time — parallel opencode calls queue.
        // the abliterated (uncensored) huihui-ai UD-IQ4_XS — see ~/.vault/strata-huihui-abliterated-ud-iq4_xs.md
        "qwen3.8-flash-next-unsloth-ud-iq4_xs": {
          "id": "qwen3.8-flash-next-unsloth-ud-iq4_xs",
          "name": "Qwen3.8 Flash-Next UD-IQ4_XS (Strata, abliterated, 256KiB)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "input": 258048,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        // the plain IQ3_S stays as the fallback model (still installed on disk)
        "qwen3.8-flash-next-iq3_s": {
          "id": "qwen3.8-flash-next-iq3_s",
          "name": "Qwen3.8 Flash-Next IQ3_S (Strata, 256KiB)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "input": 258048,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "plugin": [
    "{env:HOME}/.hindsight/coding-agents"
  ]
}
