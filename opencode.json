{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "GUIDELINES.md"
  ],
  "references": {
    "vault": {
      "path": "~/.vault/",
      "description": "Documentation vault. Use for questions about the homelab setup, architecture, services, or project notes."
    }
  },
  "skills": {
    // ToolJet app-builder skill ships inside the cloned MCP repo. `~/` is
    // expanded by opencode's skill loader (same as references.vault), so the
    // home dir stays out of this file.
    "paths": [
      "~/source/tooljet-mcp/skills"
    ]
  },
  "mcp": {
    "appsmith": {
      "type": "remote",
      "url": "{env:APPSMITH_MCP_URL}",
      "enabled": false,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:APPSMITH_MCP_KEY}"
      }
    },
    // ToolJet CE v3.20.240-lts: PAT module is stubbed, so auth uses the
    // browser session token (see .zshenv; refresh per
    // ~/.vault/tooljet-file-upload.md "Auth model").
    "tooljet": {
      "type": "local",
      "command": [
        "node",
        "/Users/kpeek/source/tooljet-mcp/bundle/index.js"
      ],
      "enabled": true,
      "environment": {
        "TOOLJET_URL": "{env:TOOLJET_URL}",
        "TOOLJET_DEPLOYMENT_URL": "{env:TOOLJET_DEPLOYMENT_URL}",
        "TOOLJET_WORKSPACE_ID": "{env:TOOLJET_WORKSPACE_ID}",
        "TOOLJET_SESSION_TOKEN": "{env:TOOLJET_SESSION_TOKEN}"
      }
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    // 252000 - 65000 = 187000 → auto-compact triggers at ~187k tokens.
    // Why so early: the compaction request serializes the whole session and
    // re-expands stored parts (reasoning text, tool-call JSON), inflating it
    // ~1.3x over the live context (observed 2026-10-08: 224.7k live → 290824
    // prompt tokens, rejected by ollama's 262144 window). Trigger must satisfy
    // trigger * 1.3 + 8192 output <= 262144 → 187000 * 1.3 + 8192 ≈ 251k ✓
    "reserved": 65000
  },
  "permission": {
    "external_directory": {
      "~/.vault/*": "allow",
      "/tmp/**": "allow",
      // /tmp is a symlink to /private/tmp on macOS; allow both path forms
      "/private/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "telnet *": "ask",
      "nc *": "ask",
      "netcat *": "ask",
      "sftp *": "ask",
      "ftp *": "ask",
      "openvpn *": "ask",
      "ike *": "ask"
    },
    "skill": {
      "web-browsing": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "${OPENCODE_OLLAMA_URI}",
        "timeout": 1200000,
        "headerTimeout": 1200000
      },
      "models": {
        "gemma2:2b": {
          "id": "gemma2:2b",
          "name": "Gemma 2 2B",
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        // The served window comes from the TAG, not from "limit" below: opencode
        // reaches ollama over the OpenAI-compatible /v1 endpoint, which ignores
        // per-request num_ctx (https://github.com/ollama/ollama/issues/16814). The
        // old :Q4_K_M tag had num_ctx 133120 baked into its Modelfile and beat any
        // client setting; -256k is the same 17 GB blob rebuilt with num_ctx 262144.
        // "limit" still matters HERE in opencode: it enables auto-compaction
        // (limit.context === 0 disables it) and the output budget. "input" is
        // REQUIRED for compaction.reserved to be honored — without it reserved is
        // silently ignored (opencode #13980 / #38835). Trigger = input - reserved
        // = 252000 - 65000 = 187000; see the reserved comment above for why.
        "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k": {
          "id": "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k",
          "name": "Qwen3.8 27B Uncensored GGUF Q4_K_M 256KiB",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 252000,
            "input": 252000,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "plugin": [
    "/Users/kpeek/.hindsight/coding-agents"
  ]
}
