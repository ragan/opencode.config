{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "web-pref.md"
  ],
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "skill": {
      "web-browsing": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "${OPENCODE_OLLAMA_URI}"
      },
      "models": {
        "qwen3.5:27b": {
          "id": "qwen3.5:27b",
          "name": "Qwen3.5 27B",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3-vl": {
          "id": "qwen3-vl:latest",
          "name": "Qwen3 Vision Language",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
