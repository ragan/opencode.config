{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    [
      "@vectorize-io/opencode-hindsight",
      {
        "hindsightApiUrl": "${HINDSIGHT_API_URL}",
        "bankId": "opencode"
      }
    ]
  ],
  "instructions": [
    "GUIDELINES.md"
  ],
  "references": {
    "vault": {
      "path": "~/.vault/",
      "description": "Documentation vault. Use for questions about the homelab setup, architecture, services, or project notes."
    }
  },
  "mcp": {
    "appsmith": {
      "type": "remote",
      "url": "{env:APPSMITH_MCP_URL}",
      "enabled": true,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:APPSMITH_MCP_KEY}"
      }
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    // 252000 - 28000 = 224000 → auto-compact triggers at ~224k tokens
    "reserved": 28000
  },
  "permission": {
    "external_directory": {
      "~/.vault/*": "allow",
      "/tmp/**": "allow",
      // /tmp is a symlink to /private/tmp on macOS; allow both path forms
      "/private/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "telnet *": "ask",
      "nc *": "ask",
      "netcat *": "ask",
      "sftp *": "ask",
      "ftp *": "ask",
      "openvpn *": "ask",
      "ike *": "ask"
    },
    "skill": {
      "web-browsing": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "${OPENCODE_OLLAMA_URI}",
        "timeout": 1200000,
        "headerTimeout": 1200000
      },
      "models": {
        "gemma2:2b": {
          "id": "gemma2:2b",
          "name": "Gemma 2 2B",
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        // The served window comes from the TAG, not from "limit" below: opencode
        // reaches ollama over the OpenAI-compatible /v1 endpoint, which ignores
        // per-request num_ctx (https://github.com/ollama/ollama/issues/16814). The
        // old :Q4_K_M tag had num_ctx 133120 baked into its Modelfile and beat any
        // client setting; -256k is the same 17 GB blob rebuilt with num_ctx 262144.
        // "limit" still matters HERE in opencode: it enables auto-compaction
        // (limit.context === 0 disables it) and the output budget. "input" is
        // REQUIRED for compaction.reserved to be honored — without it reserved is
        // silently ignored (opencode #13980 / #38835). Trigger = input - reserved
        // = 252000 - 28000 = 224000.
        "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k": {
          "id": "hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M-256k",
          "name": "Qwen3.8 27B Uncensored GGUF Q4_K_M 256KiB",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 252000,
            "input": 252000,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.8:27b": {
          "id": "qwen3.8:27b",
          "name": "Qwen3.8 27B",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
