{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "GUIDELINES.md"
  ],
  "references": {
    "vault": {
      "path": "~/.vault/",
      "description": "Documentation vault. Use for questions about the homelab setup, architecture, services, or project notes."
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "telnet *": "ask",
      "nc *": "ask",
      "netcat *": "ask",
      "sftp *": "ask",
      "ftp *": "ask",
      "openvpn *": "ask",
      "ike *": "ask"
    },
    "skill": {
      "web-browsing": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "${OPENCODE_OLLAMA_URI}",
        "timeout": 1200000,
        "headerTimeout": 1200000
      },
      "models": {
        "gemma2:2b": {
          "id": "gemma2:2b",
          "name": "Gemma 2 2B",
          "reasoning": false,
          "tool_call": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "translator-llm": {
          "id": "gemma2-translator:latest",
          "name": "Translator (Gemma 2 2B)",
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.8:27b": {
          "id": "qwen3.8:27b",
          "name": "Qwen3.8 27B",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
