{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "new_location": "inherit"
  },
  "animations": true,
  "prompt": {
    "editor": true
  },
  "attention": {
    "sound": true,
    "notifications": true
  },
  "tabs": {
    "scope": "global",
    "mode": "auto"
  }
}
